# Copy to .env and fill in real values.
OPENAI_API_KEY=your-openai-api-key
RAZZBALL_API_KEY=your-razzball-api-key

# Optional: which OpenAI model the assistant uses (defaults to gpt-6-luna).
OPENAI_MODEL=

# Optional: the folder conversations are saved in. Defaults to your per-user
# data folder, e.g. ~/Library/Application Support/malamoneyball on macOS.
MALAMONEYBALL_DATA_DIR=
